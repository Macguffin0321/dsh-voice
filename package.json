{
  "name": "dsh-voice",
  "version": "0.5.0",
  "private": true,
  "description": "KIMI-style voice broadcast for the DeepSeek Harness web GUI: reads every assistant reply aloud as it streams, with a per-message speaker button, a floating transport console (−30s / +30s / pause) and voice switching",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "test": "node scripts/test-host.mjs && node scripts/test-retry.mjs && node scripts/smoke-client.mjs",
    "smoke": "node scripts/smoke-client.mjs",
    "test:host": "node scripts/test-host.mjs",
    "dev:host": "node scripts/dev-host.mjs"
  }
}
